{
  "name": "band-studio-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tailwindcss -i ./src/app/tailwind-source.css -o ./src/app/globals.css && next build",
    "start": "next start",
    "lint": "next lint",
    "crawl": "tsx scripts/crawl-studios.ts",
    "scan:noah": "tsx scripts/scan-noah-branch.ts",
    "cf:build": "opennextjs-cloudflare build --build-command \"npm run build\"",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "wrangler": "^4.134.0"
  }
}
